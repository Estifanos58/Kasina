# ==============================================================================
# Kasina Monorepo Environment Configuration Example
# Copy to .env and replace ALL placeholder secrets before starting the stack.
# NEVER commit real credentials or .env files to source control!
# ==============================================================================

# Public Port for Nginx Reverse Proxy (Docker Compose)
APP_PORT=3000

# MongoDB Credentials (Required for Docker Compose)
MONGO_ROOT_USERNAME=kasina_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-unique-mongo-password
MONGODB_NAME=chat_app
# For local non-Docker backend runs only (Docker Compose constructs the authenticated URI automatically):
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/chat_app

# Backend Server & JWT Security (JWT_SECRET is mandatory, min 32 characters; startup fails if unset or placeholder)
PORT=8080
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Allowed CORS & WebSocket Origins (comma-separated)
# In Docker behind Nginx on port 3000: http://localhost:3000
# In production with HTTPS: https://chat.yourdomain.com
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Cookie & Security Policy
# Set COOKIE_SECURE=true in production behind HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
TRUST_FORWARDED_HEADERS=true

# Login & Signup Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_MAX_IP_ATTEMPTS=20
SIGNUP_RATE_LIMIT_MAX_IP_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=900000

# WebSocket & Storage
WEBSOCKET_HEARTBEAT_MS=10000
FILE_UPLOAD_DIR=uploads/files

# Frontend Build / Dev Configuration
# Leave VITE_SERVER_URL empty and VITE_SOCKET_URL=/ws when using Nginx or Vite proxy (recommended)
VITE_SERVER_URL=
VITE_SOCKET_URL=/ws
VITE_DEV_PROXY_TARGET=http://localhost:8080
