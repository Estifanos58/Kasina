# ==============================================================================
# Kasina Monorepo Environment Configuration Example
# Copy to .env and configure for your local or production environment.
# NEVER commit real credentials or .env files to source control!
# ==============================================================================

# Backend Configuration
PORT=8080
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/chat_app
MONGODB_NAME=chat_app
JWT_SECRET=your-random-jwt-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
FRONTEND_URL=http://localhost:5173
FILE_UPLOAD_DIR=uploads/files
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Frontend Configuration
VITE_SERVER_URL=http://localhost:8080
VITE_SOCKET_URL=http://localhost:8080/ws
